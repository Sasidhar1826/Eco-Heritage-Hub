<% layout('/layouts/boilerplate') -%>

    <div class="container mt-5 mb-5">
        <h1 class="mb-4">Your Orders</h1>

        <% if (!orders || orders.length===0) { %>
            <div class="alert alert-info">
                You haven't placed any orders yet. <a href="/products">Start shopping</a>
            </div>
            <% } else { %>
                <div class="row">
                    <% orders.forEach(order=> { %>
                        <div class="col-md-6 mb-4">
                            <div class="card shadow-sm h-100">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">Order #<%= order._id.toString().slice(-6) %>
                                    </h5>
                                    <span
                                        class="badge bg-<%= order.paymentInfo.status === 'paid' ? 'success' : 'warning' %>">
                                        <%= order.paymentInfo.status==='paid' ? 'Paid' : 'Pending' %>
                                    </span>
                                </div>
                                <div class="card-body">
                                    <p class="card-text"><strong>Date:</strong>
                                        <%= new Date(order.createdAt).toLocaleDateString() %>
                                    </p>
                                    <p class="card-text"><strong>Total:</strong> ₹<%= order.totalAmount.toFixed(2) %>
                                    </p>
                                    <p class="card-text"><strong>Status:</strong>
                                        <span class="badge bg-<%= 
                  order.orderStatus === 'processing' ? 'info' : 
                  order.orderStatus === 'shipped' ? 'primary' : 
                  order.orderStatus === 'delivered' ? 'success' : 'danger' 
                %>">
                                            <%= order.orderStatus.charAt(0).toUpperCase() + order.orderStatus.slice(1)
                                                %>
                                        </span>
                                    </p>

                                    <div class="mt-3">
                                        <h6>Items:</h6>
                                        <ul class="list-group list-group-flush">
                                            <% order.items.slice(0, 2).forEach(item=> { %>
                                                <li class="list-group-item px-0">
                                                    <div class="d-flex align-items-center">
                                                        <% if (item.product && item.product.image &&
                                                            item.product.image.url) { %>
                                                            <img src="<%= item.product.image.url %>"
                                                                alt="<%= item.product.title %>"
                                                                class="img-thumbnail me-3"
                                                                style="width: 50px; height: 50px; object-fit: cover;">
                                                            <% } else { %>
                                                                <div class="bg-secondary me-3"
                                                                    style="width: 50px; height: 50px;"></div>
                                                                <% } %>
                                                                    <div>
                                                                        <h6 class="mb-0">
                                                                            <%= item.product ? item.product.title
                                                                                : 'Product Unavailable' %>
                                                                        </h6>
                                                                        <small class="text-muted">Qty: <%= item.quantity
                                                                                %> × ₹<%= item.price.toFixed(2) %>
                                                                        </small>
                                                                    </div>
                                                    </div>
                                                </li>
                                                <% }) %>

                                                    <% if (order.items.length> 2) { %>
                                                        <li class="list-group-item px-0 text-center">
                                                            <small class="text-muted">+ <%= order.items.length - 2 %>
                                                                    more items</small>
                                                        </li>
                                                        <% } %>
                                        </ul>
                                    </div>
                                </div>
                                <div class="card-footer bg-white">
                                    <a href="/payment/orders/<%= order._id %>" class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-eye me-1"></i> View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                </div>
                <% } %>
    </div>