<style>
    .navbar {
        background-color: #ffffff !important;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1) !important;
    }

    .navbar-brand img {
        border-radius: 50%;
        height: 3rem;
    }

    .nav-link {
        color: #1e293b !important;
        font-weight: 500;
        transition: color 0.3s ease;
    }

    .nav-link:hover {
        color: #0ea5e9 !important;
    }

    .search-btn {
        background-color: #fe424d;
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        border-radius: 25px;
        padding: 0 1.5rem;
        transition: background-color 0.3s ease;
    }

    .search-input {
        border-radius: 25px;
    }

    .search-btn:hover {
        background-color: #d9343f;
    }

    .userbtn {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        border-radius: 25px;
        font-size: medium;
        padding: 0.4rem 1.3rem !important;
        transition: background-color 0.3s ease;
    }

    .logoutbtn {
        margin-left: 5px !important;
    }

    .mt-1-5 {
        margin-top: 0.675rem !important;
        /* 1.5 * 0.25rem (Bootstrap's spacing unit) */
    }

    @media (max-width: 768px) {
        .navbar-nav {
            text-align: center !important;
        }
    }
</style>

<nav class="navbar navbar-expand-md border-bottom sticky-top">
    <div class="container-fluid">
        <a class="navbar-brand" href="/products"><img src="/eco heritage hub.ico" alt="logo"></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
            <div class="navbar-nav">
                <a class="nav-link" href="/products">Explore</a>
            </div>
            <div class="navbar-nav ms-auto">
                <form class="d-flex" role="search" action="/products/search" method="GET">
                    <input class="form-control me-2 search-input" type="search" placeholder="Search product" name="q"
                        aria-label="Search">
                    <button class="btn search-btn" type="submit">
                        <i class="fa-solid fa-magnifying-glass"></i> Search
                    </button>
                </form>
            </div>

            <!-- User Authentication Links -->
            <div class="navbar-nav ms-auto">
                <% if (currUser && currUser.role==="seller" ) { %>
                    <a class="btn btn-outline-danger me-2 userbtn" href="/products/new">
                        <i class="fas fa-plus"></i> Add Product
                    </a>

                    <a class="btn btn-primary userbtn" href="/products/my-listings">
                        <i class="fas fa-list"></i> My products
                    </a>
                    <% } %>
                        <% if (!currUser) { %>
                            <a class="nav-link" href="/signup"><b>Signup</b></a>
                            <a class="nav-link" href="/login"><b>Login</b></a>
                            <% } %>

                                <% if ( currUser && currUser.role !="seller" ) { %>
                                    <a href="/cart" class="nav-link position-relative me-3" style="padding-top: 12px;">
                                        <i class="fas fa-shopping-cart fs-5 mt-2 position-relative"></i>
                                        <% if (cartItemCount && cartItemCount> 0) { %>
                                            <span
                                                class="position-absolute top-5 start-100 translate-middle badge rounded-pill bg-danger cart-count-badge"
                                                style="font-size: 0.75rem;">
                                                <%= cartItemCount %>
                                                    <span class="visually-hidden">items in cart</span>
                                            </span>
                                            <% } %>
                                    </a>
                                    <a href="/payment/orders" class="nav-link me-3 mt-2" style=" padding-top: 10px;">
                                        <i class="fas fa-receipt fs-5 me-2"></i>
                                        <span class="fw-bold">Orders</span>
                                    </a>
                                    <% if (currUser.profileImage && currUser.profileImage.url) { %>
                                        <a href="/profile" class="nav-link">
                                            <img src="<%= currUser.profileImage.url %>" alt="Profile"
                                                class="rounded-circle"
                                                style="width: 32px; height: 32px; object-fit: cover; margin-top: 5px;">
                                        </a>
                                        <% } else { %>
                                            <a href="/profile" class="nav-link">
                                                <i class="fa-regular fa-user mt-3 me-2" style="padding-top: 0px;"></i>
                                            </a>
                                            <% } %>
                                                <h3 class="fw-bold me-2" style="font-size: medium; padding-top:21px">
                                                    Hi, <%= currUser.username %>
                                                </h3>
                                                <% } %>
                                                    <% if(currUser) { %>

                                                        <a class="btn btn-danger logoutbtn userbtn"
                                                            style=<%=currUser.role==="user" ? "margin:10px;" :";" %>
                                                            href="/logout">
                                                            <i class="fas fa-sign-out-alt"></i> Logout
                                                        </a>

                                                        <% } %>
            </div>
        </div>
    </div>
</nav>