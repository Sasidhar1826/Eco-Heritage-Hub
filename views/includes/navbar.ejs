<style>
    .navbar {
        background-color: #ffffff !important;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1) !important;
    }

    .navbar-brand img {
        border-radius: 50%;
        height: 3rem;
    }

    .nav-link {
        color: #1e293b !important;
        font-weight: 500;
        transition: color 0.3s ease;
    }

    .nav-link:hover {
        color: #0ea5e9 !important;
    }

    .search-btn {
        background-color: #fe424d;
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        border-radius: 25px;
        padding: 0 1.5rem;
        transition: background-color 0.3s ease;
    }

    .search-input {
        border-radius: 25px;
    }

    .search-btn:hover {
        background-color: #d9343f;
    }

    .userbtn {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        border-radius: 25px;
        font-size: medium;
        padding: 0.32rem 1.5rem;
        transition: background-color 0.3s ease;
    }

    .logoutbtn {
        margin-left: 5px !important;
    }

    @media (max-width: 768px) {
        .navbar-nav {
            text-align: center !important;
        }
    }
</style>

<nav class="navbar navbar-expand-md border-bottom sticky-top">
    <div class="container-fluid">
        <a class="navbar-brand" href="/products"><img src="/eco heritage hub.ico" alt="logo"></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
            <div class="navbar-nav">
                <a class="nav-link" href="/products">Explore</a>
            </div>
            <div class="navbar-nav ms-auto">
                <form class="d-flex" role="search">
                    <input class="form-control me-2 search-input" type="search" placeholder="Search product">
                    <button class="btn search-btn" type="submit">
                        <i class="fa-solid fa-magnifying-glass"></i> Search
                    </button>
                </form>
            </div>

            <!-- User Authentication Links -->
            <div class="navbar-nav ms-auto">
                <% if (currUser && currUser.role==="seller" ) { %>
                    <a class="btn btn-outline-danger me-2 userbtn" href="/products/new">
                        <i class="fas fa-plus"></i> Add Product
                    </a>

                    <a class="btn btn-primary userbtn" href="/products/my-listings">
                        <i class="fas fa-list"></i> My products
                    </a>
                    <% } %>
                        <% if (!currUser) { %>
                            <a class="nav-link" href="/signup"><b>Signup</b></a>
                            <a class="nav-link" href="/login"><b>Login</b></a>
                            <% } %>

                                <% if (currUser) { %>
                                    <% if (currUser.role!="seller" ) { %>
                                        <i class="fas fa-shopping-cart ms-1 mt-3 me-3"></i>
                                        <i class="fas fa-user ms-1 mt-3 me-2" id="change"></i>
                                        <div>
                                            <p style="margin-top: 12px !important;" class="fw-bold fs-6 me-2 mt-2">
                                                Hi,
                                                <%= currUser.username %>
                                            </p>
                                        </div>
                                        <% } %>
                                            <div>
                                                <a class="btn btn-danger logoutbtn userbtn mt-2 " href="/logout">
                                                    <i class="fas fa-sign-out-alt"></i> Logout
                                                </a>
                                            </div>
                                            <% } %>


            </div>
        </div>
    </div>
</nav>